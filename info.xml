<?xml version="1.0" encoding="utf-8" ?>
<jtlshopplugin>
    <Name>FLIZpay</Name>
    <Description
    >FLIZpay - fee-free payments with discounts/cashback for your customers</Description>
    <Author>FLIZpay GmbH</Author>
    <URL>https://www.flizpay.de</URL>
    <XMLVersion>102</XMLVersion>
    <MinShopVersion>5.3.0</MinShopVersion>
    <PluginID>flizpay</PluginID>
    <CreateDate>2026-08-26</CreateDate>
    <Version>1.0.0</Version>
    <!--
    // The ExsID is generated in the JTL customer center and must be entered before the extension store release.
    <ExsID>00000000-0000-0000-0000-000000000000</ExsID>
    -->
    <Install>
        <FlushTags>CACHING_GROUP_PLUGIN</FlushTags>
        <PaymentMethod>
            <Method>
                <Name>FLIZpay</Name>
                <PictureURL>flizpay-logo.svg</PictureURL>
                <Sort>1</Sort>
                <SendMail>1</SendMail>
                <Provider>FLIZpay</Provider>
                <TSCode>OTHER</TSCode>
                <PreOrder>0</PreOrder>
                <Soap>0</Soap>
                <Curl>1</Curl>
                <Sockets>0</Sockets>
                <ClassFile>FlizPay.php</ClassFile>
                <ClassName>FlizPay</ClassName>
                <TemplateFile>template/index.tpl</TemplateFile>
                <MethodLanguage iso="GER">
                    <Name>FLIZpay</Name>
                    <ChargeName>FLIZpay</ChargeName>
                    <InfoText
                    >Sichere Zahlungen in direkter Zusammenarbeit mit deiner Bank.</InfoText>
                </MethodLanguage>
                <MethodLanguage iso="ENG">
                    <Name>FLIZpay</Name>
                    <ChargeName>FLIZpay</ChargeName>
                    <InfoText
                    >Secure payments in direct collaboration with your bank.</InfoText>
                </MethodLanguage>
            </Method>
        </PaymentMethod>
        <Adminmenu>
            <Settingslink sort="1">
                <Name>Settings</Name>
                <Setting type="text" initialValue="" sort="1" conf="N">
                    <Name>FLIZpay connection</Name>
                    <ValueName>flizpay_h_api</ValueName>
                </Setting>
                <Setting type="password" initialValue="" sort="10" conf="Y">
                    <Name>API-Key</Name>
                    <Description
                    >You can find your API key in the FLIZ company account under "Set up FLIZ" -> "Plugins" -> "JTL". After saving, the plugin automatically registers the webhook URL and verifies the connection (the "Status" tab).</Description>
                    <ValueName>flizpay_apiKey</ValueName>
                </Setting>
                <Setting type="text" initialValue="" sort="20" conf="N">
                    <Name>Order processing</Name>
                    <ValueName>flizpay_h_order</ValueName>
                </Setting>
                <Setting type="selectbox" initialValue="Y" sort="30" conf="Y">
                    <Name>Hold orders from JTL-Wawi until payment</Name>
                    <Description
                    >Recommended: The order is transferred to JTL-Wawi only after payment. This is required to apply a FLIZpay discount (cashback) to the order before transfer.</Description>
                    <ValueName>flizpay_holdFromWawi</ValueName>
                    <SelectboxOptions>
                        <Option
                            value="Y"
                            sort="1"
                        ><![CDATA[Yes (recommended)]]></Option>
                        <Option value="N" sort="2"><![CDATA[No]]></Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="text" initialValue="" sort="50" conf="N">
                    <Name>Checkout display</Name>
                    <ValueName>flizpay_h_display</ValueName>
                </Setting>
                <Setting type="selectbox" initialValue="Y" sort="60" conf="Y">
                    <Name>Show FLIZpay logo</Name>
                    <ValueName>flizpay_displayLogo</ValueName>
                    <SelectboxOptions>
                        <Option value="Y" sort="1"><![CDATA[Yes]]></Option>
                        <Option value="N" sort="2"><![CDATA[No]]></Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="Y" sort="70" conf="Y">
                    <Name
                    >Show discount in the title ("FLIZpay - Up to X% discount")</Name>
                    <Description
                    >The discount value is retrieved from your FLIZ company account and kept up to date automatically.</Description>
                    <ValueName>flizpay_displayHeadline</ValueName>
                    <SelectboxOptions>
                        <Option value="Y" sort="1"><![CDATA[Yes]]></Option>
                        <Option value="N" sort="2"><![CDATA[No]]></Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="Y" sort="80" conf="Y">
                    <Name>Show description</Name>
                    <ValueName>flizpay_displayDescription</ValueName>
                    <SelectboxOptions>
                        <Option value="Y" sort="1"><![CDATA[Yes]]></Option>
                        <Option value="N" sort="2"><![CDATA[No]]></Option>
                    </SelectboxOptions>
                </Setting>
            </Settingslink>
            <Customlink sort="2">
                <Name>Status</Name>
            </Customlink>
        </Adminmenu>
    </Install>
</jtlshopplugin>
