msgid "Pay now with FLIZpay"
msgstr "Pay now with FLIZpay"

msgid "You are being redirected to FLIZpay to complete your payment."
msgstr "You are being redirected to FLIZpay to complete your payment."

msgid "The FLIZpay payment could not be started. Please try again from your order overview or contact the shop."
msgstr "The FLIZpay payment could not be started. Please try again from your order overview or contact the shop."

msgid "Confirming your payment ..."
msgstr "Confirming your payment ..."

msgid "You will be redirected automatically once your payment is confirmed."
msgstr "You will be redirected automatically once your payment is confirmed."

msgid "Confirmation is taking longer than usual. You can check the status in your order overview at any time."
msgstr "Confirmation is taking longer than usual. You can check the status in your order overview at any time."

msgid "Payment not completed"
msgstr "Payment not completed"

msgid "Your FLIZpay payment was not completed. Nothing was charged."
msgstr "Your FLIZpay payment was not completed. Nothing was charged."

msgid "Go to order status"
msgstr "Go to order status"

msgid "Settings"
msgstr "Settings"

msgid "You can find your API key in the FLIZ company account under \"Set up FLIZ\" -> \"Plugins\" -> \"JTL\". After saving, the plugin automatically registers the webhook URL and verifies the connection below."
msgstr "You can find your API key in the FLIZ company account under \"Set up FLIZ\" -> \"Plugins\" -> \"JTL\". After saving, the plugin automatically registers the webhook URL and verifies the connection below."

msgid "Order processing"
msgstr "Order processing"

msgid "Hold orders from JTL-Wawi until payment"
msgstr "Hold orders from JTL-Wawi until payment"

msgid "Recommended: The order is transferred to JTL-Wawi only after payment. This is required to apply a FLIZpay discount (cashback) to the order before transfer."
msgstr "Recommended: The order is transferred to JTL-Wawi only after payment. This is required to apply a FLIZpay discount (cashback) to the order before transfer."

msgid "Yes (recommended)"
msgstr "Yes (recommended)"

msgid "No"
msgstr "No"

msgid "Checkout display"
msgstr "Checkout display"

msgid "Show FLIZpay logo"
msgstr "Show FLIZpay logo"

msgid "Yes"
msgstr "Yes"

msgid "Show discount in the title (\"FLIZpay - Up to X% discount\")"
msgstr "Show discount in the title (\"FLIZpay - Up to X% discount\")"

msgid "The discount value is retrieved from your FLIZ company account and kept up to date automatically."
msgstr "The discount value is retrieved from your FLIZ company account and kept up to date automatically."

msgid "Show description"
msgstr "Show description"

msgid "FLIZpay is not offered at checkout until the connection is complete."
msgstr "FLIZpay is not offered at checkout until the connection is complete."

msgid "First enter your API key above and save."
msgstr "First enter your API key above and save."

msgid "Connection established! Our servers have successfully communicated with your site. You are now ready to accept fee-free payments!"
msgstr "Connection established! Our servers have successfully communicated with your site. You are now ready to accept fee-free payments!"

msgid "Show or hide the API key"
msgstr "Show or hide the API key"

msgid "Save"
msgstr "Save"

msgid "Settings saved."
msgstr "Settings saved."

msgid "The webhook key is missing. Please save the settings again."
msgstr "The webhook key is missing. Please save the settings again."

msgid "Waiting for the FLIZpay test notification. The shop must be publicly accessible (no password protection, no IP restriction, and a valid SSL certificate)."
msgstr "Waiting for the FLIZpay test notification. The shop must be publicly accessible (no password protection, no IP restriction, and a valid SSL certificate)."

msgid "Open FLIZpay payments"
msgstr "Open FLIZpay payments"

msgid "There are currently no open FLIZpay payments."
msgstr "There are currently no open FLIZpay payments."

msgid "Order"
msgstr "Order"

msgid "Created"
msgstr "Created"

msgid "Attempt"
msgstr "Attempt"

msgid "Transaction"
msgstr "Transaction"

msgid "Amount"
msgstr "Amount"

msgid "Security check failed. Please reload the page."
msgstr "Security check failed. Please reload the page."

msgid "Action failed: %s"
msgstr "Action failed: %s"

msgid "No API key is configured. FLIZpay is disabled at checkout."
msgstr "No API key is configured. FLIZpay is disabled at checkout."

msgid "FLIZpay has already been configured. The test notification is still pending. Progress is shown below the API key."
msgstr "FLIZpay has already been configured. The test notification is still pending. Progress is shown below the API key."

msgid "The webhook URL could not be registered."
msgstr "The webhook URL could not be registered."

msgid "A webhook key could not be generated."
msgstr "A webhook key could not be generated."

msgid "FLIZpay connection established. FLIZpay is now sending a test notification to %s. Its status is shown below the API key. The payment method appears at checkout only after a successful test."
msgstr "FLIZpay connection established. FLIZpay is now sending a test notification to %s. Its status is shown below the API key. The payment method appears at checkout only after a successful test."

msgid "FLIZpay is currently unavailable: %s The API key remains saved. Please save the settings again later."
msgstr "FLIZpay is currently unavailable: %s The API key remains saved. Please save the settings again later."

msgid "FLIZpay connection failed: %s The API key was removed. Please check it and save it again."
msgstr "FLIZpay connection failed: %s The API key was removed. Please check it and save it again."

msgid "FLIZpay discount"
msgstr "FLIZpay discount"

msgid "FLIZpay: A discount of %s was granted during payment but could no longer be applied automatically. Please adjust the order discount manually in JTL-Wawi."
msgstr "FLIZpay: A discount of %s was granted during payment but could no longer be applied automatically. Please adjust the order discount manually in JTL-Wawi."

msgid "%s (order currency)"
msgstr "%s (order currency)"
